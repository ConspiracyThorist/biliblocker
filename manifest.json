{
  "manifest_version": 3,
  "name": "BiliBlocker — B站推荐流屏蔽器",
  "version": "1.0.1",
  "description": "拦截 B 站首页搬运知乎热榜的视频，并按关键词/UP/分区/数值规则过滤推荐流与评论区；网络层渲染前删除，DOM 兜底",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "*://*.bilibili.com/*",
    "https://zbb-ups-nwwblkigcf.cn-hangzhou.fcapp.run/*",
    "https://api.zhihu.com/*",
    "https://www.zhihu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BiliBlocker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
